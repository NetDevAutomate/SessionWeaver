  "flows": [
    {"id": "p2d_export_input", "from": "p2d_studyloop_sessions", "to": "p2d_session_store", "label": "session-export", "classification": "canonical session data", "variant": "emphasis", "route": "straight", "labelAt": [208, 200]},
