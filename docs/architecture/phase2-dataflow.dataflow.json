    {"id": "p2d_concept_sidecar", "type": "database", "label": "Concepts + Sidecar", "sublabel": "authoritative SQLite + FTS", "stage": 3, "row": 0, "width": 136},
    {"id": "p2d_sessionweaver_recall", "type": "backend", "label": "SessionWeaver Recall", "sublabel": "concept-first + fallback", "stage": 4, "row": 0, "width": 136},
    {"id": "p2d_ontology_branch", "type": "database", "label": "Tier-1 Ontology", "sublabel": "derived diagnostics only", "tag": "not a recall input", "stage": 2, "row": 2},
    {"id": "p2d_markdown_projection", "type": "external", "label": "Disposable Markdown", "sublabel": "regenerable projection", "stage": 3, "row": 2, "width": 136},
    {"id": "p2d_benchmark_gate", "type": "security", "label": "Benchmark Gate", "sublabel": "all-25 recall@5 0.60", "tag": "INVESTIGATE", "stage": 4, "row": 2}
