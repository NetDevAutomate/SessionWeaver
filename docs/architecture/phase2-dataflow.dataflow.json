    {"id": "p2d_derive_diagnostics", "from": "p2d_session_store", "to": "p2d_ontology_branch", "label": "derive diagnostics", "classification": "read-only", "variant": "dashed"},
    {"id": "p2d_measure_gate", "from": "p2d_sessionweaver_recall", "to": "p2d_benchmark_gate", "label": "score k=5", "classification": "fixed gate", "variant": "security", "labelAt": [960, 260]}
  ]
