    {"id": "p2d_commit_concepts", "from": "p2d_concept_writer", "to": "p2d_concept_sidecar", "label": "transactional write", "classification": "authoritative concept state", "variant": "emphasis", "route": "straight", "labelAt": [638, 200]},
