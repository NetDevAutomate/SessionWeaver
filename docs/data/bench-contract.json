{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sessionweaver.dev/schemas/benchmark-v1.json",
  "title": "SessionWeaver A6 benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "k",
    "corpus_posture",
    "eligibility",
    "comparability",
    "all_25",
    "visible_subset",
    "positive_control",
    "diagnostic_unrestricted",
    "directional_paraphrase",
    "concept_candidate_coverage",
    "per_question",
    "investigation",
    "verdict",
    "exit_code",
    "timings_seconds"
  ],
  "properties": {
    "schema": {"const": "session-weaver.benchmark.v1"},
    "k": {"const": 5},
    "corpus_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "exporter_pin_sha", "exporter_at_or_after_fix"],
      "properties": {
        "label": {"enum": ["post-fix/eligible", "pre-fix/provisional"]},
        "exporter_pin_sha": {"type": "string", "minLength": 1},
        "exporter_at_or_after_fix": {"type": "boolean"}
      }
    },
    "eligibility": {"$ref": "#/$defs/eligibility"},
    "comparability": {"enum": ["directly comparable", "not directly comparable"]},
    "all_25": {"$ref": "#/$defs/kprMetricReport"},
    "visible_subset": {"$ref": "#/$defs/kprMetricReport"},
    "positive_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expected", "metrics"],
      "properties": {
        "status": {"enum": ["pass", "investigate", "fail"]},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recall_at_5", "mrr_at_5"],
          "properties": {
            "recall_at_5": {"const": [0.38, 0.58]},
            "mrr_at_5": {"const": [0.28, 0.48]}
          }
        },
        "metrics": {"$ref": "#/$defs/kprMetricReport"}
      }
    },
    "diagnostic_unrestricted": {"$ref": "#/$defs/kprMetricReport"},
    "directional_paraphrase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "corpus_verified", "metrics"],
      "properties": {
        "label": {"const": "directional"},
        "corpus_verified": {"type": "integer", "minimum": 40},
        "metrics": {"$ref": "#/$defs/pMetricReport"}
      }
    },
    "concept_candidate_coverage": {"$ref": "#/$defs/frozenCoverage"},
    "per_question": {"$ref": "#/$defs/perQuestionRows"},
    "investigation": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/investigation"}
      ]
    },
    "verdict": {"enum": ["pass", "investigate", "fail"]},
    "exit_code": {"enum": [0, 1, 3]},
    "timings_seconds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark"],
      "properties": {
        "benchmark": {"type": "number", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "investigate"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {"investigation": {"$ref": "#/$defs/investigation"}}
      },
      "else": {
        "properties": {"investigation": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "interval": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "hits", "recall_at_5", "recall_ci95", "mrr_at_5", "mrr_ci95"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "hits": {"type": "integer", "minimum": 0},
        "recall_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "recall_ci95": {"$ref": "#/$defs/interval"},
        "mrr_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr_ci95": {"$ref": "#/$defs/interval"}
      }
    },
    "kprMetricReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "categories"],
      "properties": {
        "overall": {"$ref": "#/$defs/metric"},
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["K", "P", "R"],
          "properties": {
            "K": {"$ref": "#/$defs/metric"},
            "P": {"$ref": "#/$defs/metric"},
            "R": {"$ref": "#/$defs/metric"}
          }
        }
      }
    },
    "pMetricReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "categories"],
      "properties": {
        "overall": {"$ref": "#/$defs/metric"},
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["P"],
          "properties": {"P": {"$ref": "#/$defs/metric"}}
        }
      }
    },
    "questionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "K", "P", "R"],
      "properties": {
        "total": {"type": "integer", "minimum": 0, "maximum": 25},
        "K": {"type": "integer", "minimum": 0, "maximum": 11},
        "P": {"type": "integer", "minimum": 0, "maximum": 8},
        "R": {"type": "integer", "minimum": 0, "maximum": 6}
      }
    },
    "sessionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "missing", "tombstoned", "other"],
      "properties": {
        "visible": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "tombstoned": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "visible", "visible_question_ids", "gold_sessions", "gold_sessions_by_category"],
      "properties": {
        "all": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "K", "P", "R"],
          "properties": {
            "total": {"const": 25},
            "K": {"const": 11},
            "P": {"const": 8},
            "R": {"const": 6}
          }
        },
        "visible": {"$ref": "#/$defs/questionCounts"},
        "visible_question_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 25,
          "items": {"enum": ["K01", "K02", "K03", "K04", "K05", "K06", "K08", "K09", "K10", "K11", "K12", "P01", "P02", "P03", "P04", "P05", "P06", "P07", "P10", "R01", "R02", "R03", "R04", "R05", "R06"]}
        },
        "gold_sessions": {"$ref": "#/$defs/sessionCounts"},
        "gold_sessions_by_category": {
          "type": "object",
          "additionalProperties": false,
          "required": ["K", "P", "R"],
          "properties": {
            "K": {"$ref": "#/$defs/sessionCounts"},
            "P": {"$ref": "#/$defs/sessionCounts"},
            "R": {"$ref": "#/$defs/sessionCounts"}
          }
        }
      }
    },
    "questionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "eligible", "visible_gold_sessions", "hit", "reciprocal_rank", "concept_candidates"],
      "properties": {
        "id": {"type": "string", "pattern": "^[KPR][0-9]{2}$"},
        "type": {"enum": ["K", "P", "R"]},
        "eligible": {"type": "boolean"},
        "visible_gold_sessions": {"type": "integer", "minimum": 0},
        "hit": {"enum": [0, 1]},
        "reciprocal_rank": {"type": "number", "minimum": 0, "maximum": 1},
        "concept_candidates": {"type": "integer", "minimum": 0}
      }
    },
    "investigationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "eligible", "visible_gold_sessions", "hit", "previous_hit", "concept_candidates"],
      "properties": {
        "id": {"type": "string", "pattern": "^[KPR][0-9]{2}$"},
        "type": {"enum": ["K", "P", "R"]},
        "eligible": {"type": "boolean"},
        "visible_gold_sessions": {"type": "integer", "minimum": 0},
        "hit": {"enum": [0, 1]},
        "previous_hit": {"enum": [0, 1]},
        "concept_candidates": {"type": "integer", "minimum": 0}
      }
    },
    "perQuestionRows": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "prefixItems": [
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K01"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K02"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K03"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K04"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K05"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K06"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K08"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K09"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K10"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K11"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "K12"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "P01"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "P02"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "P03"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "P04"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "P05"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "P06"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "P07"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "P10"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "R01"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "R02"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "R03"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "R04"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "R05"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/questionRow", "properties": {"id": {"const": "R06"}, "type": {"const": "R"}}}
      ],
      "items": false
    },
    "investigationRows": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "prefixItems": [
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K01"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K02"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K03"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K04"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K05"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K06"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K08"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K09"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K10"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K11"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "K12"}, "type": {"const": "K"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "P01"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "P02"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "P03"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "P04"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "P05"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "P06"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "P07"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "P10"}, "type": {"const": "P"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "R01"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "R02"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "R03"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "R04"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "R05"}, "type": {"const": "R"}}},
        {"$ref": "#/$defs/investigationRow", "properties": {"id": {"const": "R06"}, "type": {"const": "R"}}}
      ],
      "items": false
    },
    "frozenCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["K01", "K02", "K03", "K04", "K05", "K06", "K08", "K09", "K10", "K11", "K12", "P01", "P02", "P03", "P04", "P05", "P06", "P07", "P10", "R01", "R02", "R03", "R04", "R05", "R06"],
      "properties": {
        "K01": {"type": "integer", "minimum": 0}, "K02": {"type": "integer", "minimum": 0}, "K03": {"type": "integer", "minimum": 0}, "K04": {"type": "integer", "minimum": 0}, "K05": {"type": "integer", "minimum": 0}, "K06": {"type": "integer", "minimum": 0}, "K08": {"type": "integer", "minimum": 0}, "K09": {"type": "integer", "minimum": 0}, "K10": {"type": "integer", "minimum": 0}, "K11": {"type": "integer", "minimum": 0}, "K12": {"type": "integer", "minimum": 0},
        "P01": {"type": "integer", "minimum": 0}, "P02": {"type": "integer", "minimum": 0}, "P03": {"type": "integer", "minimum": 0}, "P04": {"type": "integer", "minimum": 0}, "P05": {"type": "integer", "minimum": 0}, "P06": {"type": "integer", "minimum": 0}, "P07": {"type": "integer", "minimum": 0}, "P10": {"type": "integer", "minimum": 0},
        "R01": {"type": "integer", "minimum": 0}, "R02": {"type": "integer", "minimum": 0}, "R03": {"type": "integer", "minimum": 0}, "R04": {"type": "integer", "minimum": 0}, "R05": {"type": "integer", "minimum": 0}, "R06": {"type": "integer", "minimum": 0}
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hit_miss_flips", "questions"],
      "properties": {
        "hit_miss_flips": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "from", "to"],
            "properties": {
              "id": {"enum": ["K01", "K02", "K03", "K04", "K05", "K06", "K08", "K09", "K10", "K11", "K12", "P01", "P02", "P03", "P04", "P05", "P06", "P07", "P10", "R01", "R02", "R03", "R04", "R05", "R06"]},
              "from": {"enum": [0, 1]},
              "to": {"enum": [0, 1]}
            }
          }
        },
        "questions": {"$ref": "#/$defs/investigationRows"}
      }
    }
  }
}
