{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sessionweaver.dev/schemas/benchmark-v1.json",
  "title": "SessionWeaver A6 benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "k",
    "corpus_posture",
    "eligibility",
    "comparability",
    "all_25",
    "visible_subset",
    "positive_control",
    "diagnostic_unrestricted",
    "directional_paraphrase",
    "concept_candidate_coverage",
    "per_question",
    "investigation",
    "verdict",
    "exit_code",
    "timings_seconds"
  ],
  "properties": {
    "schema": {"const": "session-weaver.benchmark.v1"},
    "k": {"const": 5},
    "corpus_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "exporter_pin_sha", "exporter_at_or_after_fix"],
      "properties": {
        "label": {"enum": ["post-fix/eligible", "pre-fix/provisional"]},
        "exporter_pin_sha": {"type": "string"},
        "exporter_at_or_after_fix": {"type": "boolean"}
      }
    },
    "eligibility": {"type": "object"},
    "comparability": {"enum": ["directly comparable", "not directly comparable"]},
    "all_25": {"$ref": "#/$defs/metricReport"},
    "visible_subset": {"$ref": "#/$defs/metricReport"},
    "positive_control": {
      "type": "object",
      "required": ["status", "expected", "metrics"],
      "properties": {
        "status": {"enum": ["pass", "investigate", "fail"]},
        "expected": {"type": "object"},
        "metrics": {"$ref": "#/$defs/metricReport"}
      }
    },
    "diagnostic_unrestricted": {"$ref": "#/$defs/metricReport"},
    "directional_paraphrase": {
      "type": "object",
      "required": ["label", "corpus_verified", "metrics"],
      "properties": {
        "label": {"const": "directional"},
        "corpus_verified": {"type": "integer", "minimum": 40},
        "metrics": {"$ref": "#/$defs/metricReport"}
      }
    },
    "concept_candidate_coverage": {
      "type": "object",
      "patternProperties": {"^[KPR][0-9]{2}$": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "per_question": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "eligible", "visible_gold_sessions", "hit", "reciprocal_rank", "concept_candidates"],
        "properties": {
          "id": {"pattern": "^[KPR][0-9]{2}$"},
          "type": {"enum": ["K", "P", "R"]},
          "eligible": {"type": "boolean"},
          "visible_gold_sessions": {"type": "integer", "minimum": 0},
          "hit": {"enum": [0, 1]},
          "reciprocal_rank": {"type": "number", "minimum": 0, "maximum": 1},
          "concept_candidates": {"type": "integer", "minimum": 0}
        }
      }
    },
    "investigation": {"type": ["object", "null"]},
    "verdict": {"enum": ["pass", "investigate", "fail"]},
    "exit_code": {"enum": [0, 1, 3]},
    "timings_seconds": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "hits", "recall_at_5", "recall_ci95", "mrr_at_5", "mrr_ci95"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "hits": {"type": "integer", "minimum": 0},
        "recall_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "recall_ci95": {"$ref": "#/$defs/interval"},
        "mrr_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr_ci95": {"$ref": "#/$defs/interval"}
      }
    },
    "interval": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "metricReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "categories"],
      "properties": {
        "overall": {"$ref": "#/$defs/metric"},
        "categories": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/metric"}
        }
      }
    }
  }
}
